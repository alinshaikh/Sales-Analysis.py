# ============================================================
# E-COMMERCE SALES DATA ANALYSIS PROJECT
# Dataset: 1,000 E-Commerce Transactions
# Tool: Python + Pandas + NumPy + Matplotlib
# ============================================================


# ============================================================
# 1. IMPORT LIBRARIES
# ============================================================

# Pandas -> used for data manipulation and analysis
# NumPy -> used for numerical calculations
# Matplotlib -> used for data visualization

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# 2. LOAD THE DATASET
# ============================================================

# Read the CSV file into a Pandas DataFrame.
# Make sure "ecommerce_sales.csv" is in the same folder
# as your Python file/notebook.

df = pd.read_csv("ecommerce_sales.csv")

# Display the first 5 rows
print(df.head())


# ============================================================
# 3. UNDERSTANDING THE DATASET
# ============================================================

# Number of rows and columns
print("\nDataset Shape:")
print(df.shape)

# Number of rows
print("\nTotal Records:", df.shape[0])

# Number of columns
print("Total Columns:", df.shape[1])

# Display all column names
print("\nColumn Names:")
print(df.columns.tolist())

# Display data types of every column
print("\nData Types:")
print(df.dtypes)

# Display complete information about the dataset
print("\nDataset Information:")
df.info()


# ============================================================
# 4. CHECK FOR MISSING VALUES
# ============================================================

# Count missing values in every column.
# This is important because real-world datasets
# commonly contain incomplete information.

print("\nMissing Values:")
print(df.isnull().sum())

# Display only columns that contain missing values
print("\nColumns With Missing Values:")
print(df.isnull().sum()[df.isnull().sum() > 0])


# ============================================================
# 5. CHECK FOR DUPLICATE RECORDS
# ============================================================

# Duplicate records can cause incorrect calculations.
# For example, duplicated orders could artificially increase
# total sales.

duplicates = df.duplicated().sum()

print("\nDuplicate Records:", duplicates)


# ============================================================
# 6. CONVERT ORDER_DATE INTO DATE FORMAT
# ============================================================

# Convert Order_Date from text/string into datetime.
# This allows us to perform monthly, yearly and daily analysis.

df["Order_Date"] = pd.to_datetime(df["Order_Date"])

print("\nMinimum Order Date:", df["Order_Date"].min())
print("Maximum Order Date:", df["Order_Date"].max())


# ============================================================
# 7. BASIC STATISTICAL SUMMARY
# ============================================================

# describe() gives statistics such as:
# count, mean, minimum, maximum, standard deviation etc.

print("\nStatistical Summary:")
print(df.describe())


# ============================================================
# 8. TOTAL SALES / REVENUE
# ============================================================

# Calculate total revenue generated from all transactions.

total_sales = df["Sales"].sum()

print("\nTotal Sales:", round(total_sales, 2))


# ============================================================
# 9. TOTAL COST
# ============================================================

# Calculate total cost associated with the transactions.

total_cost = df["Cost"].sum()

print("Total Cost:", round(total_cost, 2))


# ============================================================
# 10. TOTAL PROFIT
# ============================================================

# Profit = Sales - Cost

total_profit = df["Profit"].sum()

print("Total Profit:", round(total_profit, 2))


# ============================================================
# 11. OVERALL PROFIT MARGIN
# ============================================================

# Profit Margin tells us what percentage of revenue
# is retained as profit.

profit_margin = (total_profit / total_sales) * 100

print("Overall Profit Margin:",
      round(profit_margin, 2), "%")


# ============================================================
# 12. TOTAL QUANTITY SOLD
# ============================================================

# Calculate the total number of product units sold.

total_quantity = df["Quantity"].sum()

print("Total Quantity Sold:", total_quantity)


# ============================================================
# 13. TOTAL ORDERS
# ============================================================

# nunique() counts unique order IDs.

total_orders = df["Order_ID"].nunique()

print("Total Orders:", total_orders)


# ============================================================
# 14. TOTAL UNIQUE CUSTOMERS
# ============================================================

# Count unique customers.

total_customers = df["Customer_ID"].nunique()

print("Total Unique Customers:", total_customers)


# ============================================================
# 15. AVERAGE ORDER VALUE (AOV)
# ============================================================

# AOV tells us the average amount spent per order.

aov = total_sales / total_orders

print("Average Order Value:", round(aov, 2))


# ============================================================
# 16. MONTHLY SALES ANALYSIS
# ============================================================

# Group transactions by month and calculate total sales.

monthly_sales = df.groupby(
    df["Order_Date"].dt.to_period("M")
)["Sales"].sum()

print("\nMonthly Sales:")
print(monthly_sales)


# ============================================================
# 17. MONTHLY PROFIT ANALYSIS
# ============================================================

# Calculate total profit for each month.

monthly_profit = df.groupby(
    df["Order_Date"].dt.to_period("M")
)["Profit"].sum()

print("\nMonthly Profit:")
print(monthly_profit)


# ============================================================
# 18. MONTHLY SALES VISUALIZATION
# ============================================================

# Create a line chart to identify sales trends over time.

monthly_sales.plot(
    kind="line",
    marker="o"
)

plt.title("Monthly Sales Trend")
plt.xlabel("Month")
plt.ylabel("Sales")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()


# ============================================================
# 19. SALES BY CATEGORY
# ============================================================

# Find which product category generates the most revenue.

category_sales = df.groupby(
    "Category"
)["Sales"].sum().sort_values(ascending=False)

print("\nSales by Category:")
print(category_sales)


# ============================================================
# 20. PROFIT BY CATEGORY
# ============================================================

# Find which category generates the most profit.

category_profit = df.groupby(
    "Category"
)["Profit"].sum().sort_values(ascending=False)

print("\nProfit by Category:")
print(category_profit)


# ============================================================
# 21. CATEGORY SALES VISUALIZATION
# ============================================================

category_sales.plot(kind="bar")

plt.title("Sales by Category")
plt.xlabel("Category")
plt.ylabel("Sales")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()


# ============================================================
# 22. TOP 10 BEST-SELLING PRODUCTS
# ============================================================

# Calculate total quantity sold for every product
# and display the top 10.

top_products = df.groupby(
    "Product"
)["Quantity"].sum().sort_values(
    ascending=False
).head(10)

print("\nTop 10 Best-Selling Products:")
print(top_products)


# ============================================================
# 23. TOP 10 PRODUCTS BY REVENUE
# ============================================================

# Find products that generated the highest revenue.

top_revenue_products = df.groupby(
    "Product"
)["Sales"].sum().sort_values(
    ascending=False
).head(10)

print("\nTop 10 Products by Revenue:")
print(top_revenue_products)


# ============================================================
# 24. TOP 10 PRODUCTS BY PROFIT
# ============================================================

# Find products that generated the highest profit.

top_profit_products = df.groupby(
    "Product"
)["Profit"].sum().sort_values(
    ascending=False
).head(10)

print("\nTop 10 Products by Profit:")
print(top_profit_products)


# ============================================================
# 25. TOP PRODUCTS VISUALIZATION
# ============================================================

top_products.plot(kind="barh")

plt.title("Top 10 Best-Selling Products")
plt.xlabel("Quantity Sold")
plt.ylabel("Product")

# Put the highest value at the top
plt.gca().invert_yaxis()

plt.tight_layout()
plt.show()


# ============================================================
# 26. SALES BY REGION
# ============================================================

# Compare revenue generated by different geographical regions.

region_sales = df.groupby(
    "Region"
)["Sales"].sum().sort_values(ascending=False)

print("\nSales by Region:")
print(region_sales)


# ============================================================
# 27. PROFIT BY REGION
# ============================================================

# Compare profitability across regions.

region_profit = df.groupby(
    "Region"
)["Profit"].sum().sort_values(ascending=False)

print("\nProfit by Region:")
print(region_profit)


# ============================================================
# 28. SALES BY CITY
# ============================================================

# Identify cities generating the highest revenue.

city_sales = df.groupby(
    "City"
)["Sales"].sum().sort_values(ascending=False)

print("\nSales by City:")
print(city_sales)


# ============================================================
# 29. PROFIT BY CITY
# ============================================================

# Identify the most profitable cities.

city_profit = df.groupby(
    "City"
)["Profit"].sum().sort_values(ascending=False)

print("\nProfit by City:")
print(city_profit)


# ============================================================
# 30. CUSTOMER ANALYSIS
# ============================================================

# Count customers based on their customer type:
# New, Returning or Loyal.

customer_type = df["Customer_Type"].value_counts()

print("\nCustomer Type Distribution:")
print(customer_type)


# ============================================================
# 31. SALES BY CUSTOMER TYPE
# ============================================================

# Find which customer segment generates the most revenue.

customer_type_sales = df.groupby(
    "Customer_Type"
)["Sales"].sum().sort_values(ascending=False)

print("\nSales by Customer Type:")
print(customer_type_sales)


# ============================================================
# 32. TOP 10 CUSTOMERS BY SPENDING
# ============================================================

# Group sales by customer and identify the customers
# who have spent the most.

top_customers = df.groupby(
    ["Customer_ID", "Customer_Name"]
)["Sales"].sum().sort_values(
    ascending=False
).head(10)

print("\nTop 10 Customers by Spending:")
print(top_customers)


# ============================================================
# 33. PAYMENT METHOD ANALYSIS
# ============================================================

# Count how many orders were made using each payment method.

payment_orders = df["Payment_Mode"].value_counts()

print("\nOrders by Payment Method:")
print(payment_orders)


# ============================================================
# 34. SALES BY PAYMENT METHOD
# ============================================================

# Calculate revenue generated through each payment method.

payment_sales = df.groupby(
    "Payment_Mode"
)["Sales"].sum().sort_values(ascending=False)

print("\nSales by Payment Method:")
print(payment_sales)


# ============================================================
# 35. MARKETING CHANNEL ANALYSIS
# ============================================================

# Determine how many sales came through different
# marketing channels.

marketing_sales = df.groupby(
    "Marketing_Channel"
)["Sales"].sum().sort_values(ascending=False)

print("\nSales by Marketing Channel:")
print(marketing_sales)


# ============================================================
# 36. PROFIT BY MARKETING CHANNEL
# ============================================================

# Determine which marketing channel generates
# the highest profit.

marketing_profit = df.groupby(
    "Marketing_Channel"
)["Profit"].sum().sort_values(ascending=False)

print("\nProfit by Marketing Channel:")
print(marketing_profit)


# ============================================================
# 37. COUPON ANALYSIS
# ============================================================

# Compare sales from customers who used coupons
# against customers who didn't.

coupon_sales = df.groupby(
    "Coupon_Used"
)["Sales"].sum()

print("\nSales: Coupon vs Non-Coupon:")
print(coupon_sales)


# ============================================================
# 38. ORDER STATUS ANALYSIS
# ============================================================

# Count Delivered, Shipped, Processing,
# Cancelled and Returned orders.

order_status = df["Order_Status"].value_counts()

print("\nOrder Status:")
print(order_status)


# ============================================================
# 39. RETURN RATE
# ============================================================

# Calculate the percentage of orders that were returned.

return_rate = (
    (df["Order_Status"] == "Returned").sum()
    / len(df)
) * 100

print("\nReturn Rate:",
      round(return_rate, 2), "%")


# ============================================================
# 40. CANCELLATION RATE
# ============================================================

# Calculate the percentage of orders that were cancelled.

cancellation_rate = (
    (df["Order_Status"] == "Cancelled").sum()
    / len(df)
) * 100

print("Cancellation Rate:",
      round(cancellation_rate, 2), "%")


# ============================================================
# 41. AVERAGE DELIVERY TIME
# ============================================================

# Some orders such as cancelled or processing orders
# may not have delivery information.
# mean() automatically ignores missing values.

average_delivery = df["Delivery_Days"].mean()

print("\nAverage Delivery Days:",
      round(average_delivery, 2))


# ============================================================
# 42. SHIPPING MODE ANALYSIS
# ============================================================

# Compare different shipping methods based on:
# Number of orders
# Sales
# Profit
# Average delivery time

shipping_analysis = df.groupby(
    "Shipping_Mode"
).agg(
    Orders=("Order_ID", "count"),
    Sales=("Sales", "sum"),
    Profit=("Profit", "sum"),
    Avg_Delivery_Days=("Delivery_Days", "mean")
)

print("\nShipping Mode Analysis:")
print(shipping_analysis)


# ============================================================
# 43. CUSTOMER SATISFACTION / RATINGS
# ============================================================

# Calculate the average customer rating.

average_rating = df["Rating"].mean()

print("\nAverage Customer Rating:",
      round(average_rating, 2))


# ============================================================
# 44. RATING DISTRIBUTION
# ============================================================

# Count how many customers gave each rating.

rating_distribution = df["Rating"].value_counts().sort_index()

print("\nRating Distribution:")
